rules_version = '2';

// Firestore Security Rules for Pondo.
//
// These rules are NOT required for Firebase Authentication / Google sign-in
// to work — Authentication and Firestore are separate products. Enable the
// Google provider under Firebase Console > Authentication > Sign-in method
// instead; that is what fixes an "auth/operation-not-allowed" error.
//
// Data model:
//   /users/{uid}                                   — profile + orgMemberships (every org this
//                                                     user belongs to) + activeOrganizationId
//                                                     (which one is currently loaded on this
//                                                     device, or null for the local-only
//                                                     "Personal" workspace) + appSettings (the
//                                                     signed-in user's app preferences —
//                                                     appearance/sound/motion/animation/
//                                                     presentation — synced across their
//                                                     devices/browsers); self-access only.
//                                                     Legacy accounts may only have a single
//                                                     "organizationId" field — the client
//                                                     migrates that into the fields above.
//   /organizations/{orgId}                         — org profile (name, createdBy, createdAt)
//   /organizations/{orgId}/members/{uid}           — membership + role for that org. A uid can
//                                                     have a members/{uid} doc under any number
//                                                     of organizations — that's what makes
//                                                     belonging to several orgs possible, each
//                                                     with its own fully isolated data below.
//   /organizations/{orgId}/data/{docId}            — shared fund-tracker data (e.g. "snapshot")
//   /invites/{code}                                — single-use-ish invite link/code -> org + role
//
// Roles: "owner" (manage members, full data edit), "disbursing" and
// "project-manager" (full data edit), "reviewer" (read-only — enforced
// here, not just hidden in the UI).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function memberDoc(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(uid()));
    }
    function isMember(orgId) {
      return signedIn() && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(uid()));
    }
    function roleIn(orgId) {
      return memberDoc(orgId).data.role;
    }
    function isOwner(orgId) {
      return isMember(orgId) && roleIn(orgId) == 'owner';
    }
    function canEditData(orgId) {
      return isMember(orgId) && roleIn(orgId) != 'reviewer';
    }

    // ---- user profiles: each user owns their own /users/{uid} subtree ----
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // ---- organizations ----
    match /organizations/{orgId} {
      allow read: if isMember(orgId);
      allow create: if signedIn() && request.resource.data.createdBy == uid()
                    && !exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(uid()))
                    && getAfter(/databases/$(database)/documents/organizations/$(orgId)/members/$(uid())).data.role == 'owner';
      allow update, delete: if isOwner(orgId);

      match /members/{memberId} {
        // Members can list each other; a user can always check their own
        // membership doc (even if it doesn't exist, e.g. after being removed).
        allow read: if isMember(orgId) || (signedIn() && memberId == uid());

        // Bootstrap the creator only in the same atomic write as a new org.
        allow create: if signedIn() && memberId == uid()
                       && request.resource.data.uid == uid()
                       && request.resource.data.role == 'owner'
                       && !exists(/databases/$(database)/documents/organizations/$(orgId))
                       && getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.createdBy == uid();

        // Redeeming an invite must atomically consume one use. getAfter ties
        // membership creation to the counter update in the same transaction.
        allow create: if signedIn() && memberId == uid()
                       && request.resource.data.uid == uid()
                       && request.resource.data.inviteCode is string
                       && request.resource.data.role in ['reviewer', 'disbursing', 'project-manager']
                       && request.resource.data.role == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.role
                       && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.orgId == orgId
                       && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.revoked == false
                       && (get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.expiresAt == null
                           || request.time < get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.expiresAt)
                       && (get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.maxUses == null
                           || get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.usedCount
                              < get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.maxUses)
                       && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.usedCount
                          == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.usedCount + 1;

        allow update: if isOwner(orgId);
        allow delete: if isOwner(orgId) || (signedIn() && memberId == uid());
      }

      match /data/{docId} {
        allow read: if isMember(orgId);
        // Old clients performed unconditional snapshot writes. Reject them and
        // require a monotonic revision, including on the first legacy upgrade.
        // Clients must still use a transaction: rules cannot prove they did.
        allow create: if docId == 'snapshot' && canEditData(orgId)
                      && request.resource.data._syncRevision is int
                      && request.resource.data._syncRevision == 1
                      && request.resource.data.updatedBy == uid();
        allow update: if docId == 'snapshot' && canEditData(orgId)
                      && resource.data.get('_syncRevision', 0) is int
                      && resource.data.get('_syncRevision', 0) >= 0
                      && request.resource.data._syncRevision is int
                      && request.resource.data._syncRevision == resource.data.get('_syncRevision', 0) + 1
                      && request.resource.data.updatedBy == uid();
        allow delete: if false;
      }
    }

    // ---- invites ----
    match /invites/{code} {
      // Needs to be readable by a signed-in user who is redeeming it (before
      // they are a member of the target org).
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == uid() && isOwner(request.resource.data.orgId)
                    && request.resource.data.role in ['reviewer', 'disbursing', 'project-manager']
                    && request.resource.data.usedCount == 0 && request.resource.data.revoked == false
                    && (request.resource.data.maxUses == null || (request.resource.data.maxUses is int && request.resource.data.maxUses > 0))
                    && (request.resource.data.expiresAt == null || request.resource.data.expiresAt is timestamp);
      // The same transaction must create the caller's matching membership.
      allow update: if signedIn()
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
                     && request.resource.data.usedCount == resource.data.usedCount + 1
                     && resource.data.revoked == false
                     && (resource.data.expiresAt == null || request.time < resource.data.expiresAt)
                     && (resource.data.maxUses == null || resource.data.usedCount < resource.data.maxUses)
                     && !exists(/databases/$(database)/documents/organizations/$(resource.data.orgId)/members/$(uid()))
                     && getAfter(/databases/$(database)/documents/organizations/$(resource.data.orgId)/members/$(uid())).data.inviteCode == code
                     && getAfter(/databases/$(database)/documents/organizations/$(resource.data.orgId)/members/$(uid())).data.role == resource.data.role;
      allow delete: if signedIn() && isOwner(resource.data.orgId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
