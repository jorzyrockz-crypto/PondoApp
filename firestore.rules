rules_version = '2';

// Firestore Security Rules for Pondo.
//
// These rules are NOT required for Firebase Authentication / Google sign-in
// to work — Authentication and Firestore are separate products. Enable the
// Google provider under Firebase Console > Authentication > Sign-in method
// instead; that is what fixes an "auth/operation-not-allowed" error.
//
// These rules apply once (if) the app starts reading/writing Firestore —
// e.g. to sync each user's fund tracker data to the cloud. They default to
// a per-user data model: every signed-in user can only read and write
// documents that live under their own /users/{uid} path. Everything else
// is denied by default.

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything unless a more specific rule below matches.
    match /{document=**} {
      allow read, write: if false;
    }

    // Each user owns a subtree keyed by their own Firebase Auth uid.
    // e.g. /users/{uid}/profile, /users/{uid}/funds/{fundId}, etc.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
