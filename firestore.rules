rules_version = '2';

// Firestore Security Rules for Pondo.
//
// These rules are NOT required for Firebase Authentication / Google sign-in
// to work — Authentication and Firestore are separate products. Enable the
// Google provider under Firebase Console > Authentication > Sign-in method
// instead; that is what fixes an "auth/operation-not-allowed" error.
//
// Data model:
//   /users/{uid}                                   — profile + organizationId pointer, self-access only
//   /organizations/{orgId}                         — org profile (name, createdBy, createdAt)
//   /organizations/{orgId}/members/{uid}           — membership + role for that org
//   /organizations/{orgId}/data/{docId}            — shared fund-tracker data (e.g. "snapshot")
//   /invites/{code}                                — single-use-ish invite link/code -> org + role
//
// Roles: "owner" (manage members, full data edit), "disbursing" and
// "project-manager" (full data edit), "reviewer" (read-only — enforced
// here, not just hidden in the UI).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function memberDoc(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(uid()));
    }
    function isMember(orgId) {
      return signedIn() && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(uid()));
    }
    function roleIn(orgId) {
      return memberDoc(orgId).data.role;
    }
    function isOwner(orgId) {
      return isMember(orgId) && roleIn(orgId) == 'owner';
    }
    function canEditData(orgId) {
      return isMember(orgId) && roleIn(orgId) != 'reviewer';
    }

    // ---- user profiles: each user owns their own /users/{uid} subtree ----
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // ---- organizations ----
    match /organizations/{orgId} {
      allow read: if isMember(orgId);
      allow create: if signedIn() && request.resource.data.createdBy == uid();
      allow update, delete: if isOwner(orgId);

      match /members/{memberId} {
        // Members can list each other; a user can always check their own
        // membership doc (even if it doesn't exist, e.g. after being removed).
        allow read: if isMember(orgId) || (signedIn() && memberId == uid());

        // Case 1: becoming the owner of a brand-new org you just created.
        allow create: if signedIn() && memberId == uid()
                       && request.resource.data.role == 'owner'
                       && get(/databases/$(database)/documents/organizations/$(orgId)).data.createdBy == uid();

        // Case 2: joining via a valid, unexpired, unused-up invite whose
        // role matches exactly what the invite grants.
        allow create: if signedIn() && memberId == uid()
                       && request.resource.data.role == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.role
                       && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.orgId == orgId
                       && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.revoked != true
                       && (get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.maxUses == null
                           || get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.usedCount
                              < get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.maxUses);

        allow update: if isOwner(orgId);
        allow delete: if isOwner(orgId) || (signedIn() && memberId == uid());
      }

      match /data/{docId} {
        allow read: if isMember(orgId);
        allow write: if canEditData(orgId);
      }
    }

    // ---- invites ----
    match /invites/{code} {
      // Needs to be readable by a signed-in user who is redeeming it (before
      // they are a member of the target org).
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == uid() && isOwner(request.resource.data.orgId);
      // A joining member may only increment usedCount by exactly 1 and may
      // not change anything else about the invite.
      allow update: if signedIn()
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
                     && request.resource.data.usedCount == resource.data.usedCount + 1
                     && (resource.data.maxUses == null || resource.data.usedCount < resource.data.maxUses);
      allow delete: if signedIn() && isOwner(resource.data.orgId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
