{
  "name": "Pondo — Fund Tracker",
  "short_name": "Pondo",
  "description": "Track and manage your funds with Pondo.",
  "id": "/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "orientation": "portrait-primary",
  "background_color": "#f7f7f5",
  "theme_color": "#059669",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "finance",
    "productivity"
  ],
  "icons": [
