// EXPERIMENT ONLY. This is not Pondo's deployed ruleset and is not a complete
// Faculty Fund. It proves a small subset of the direct-Firestore design.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function member(o,u) { return /databases/$(database)/documents/organizations/$(o)/members/$(u); }
  function config(o) { return /databases/$(database)/documents/organizations/$(o)/sparkConfig/current; }
  function ledger(o) { return /databases/$(database)/documents/organizations/$(o)/sparkLedger/current; }
  function person(o,p) { return /databases/$(database)/documents/organizations/$(o)/sparkPeople/$(p); }
  function payment(o,p) { return /databases/$(database)/documents/organizations/$(o)/sparkPayments/$(p); }
  function remit(o,r) { return /databases/$(database)/documents/organizations/$(o)/sparkRemittances/$(r); }
  function line(o,r,p) { return /databases/$(database)/documents/organizations/$(o)/sparkLines/$(r + '~' + p); }
  function correction(o,c) { return /databases/$(database)/documents/organizations/$(o)/sparkCorrections/$(c); }
  function expense(o,e) { return /databases/$(database)/documents/organizations/$(o)/sparkExpenses/$(e); }
  function signed(o) { return request.auth != null && exists(member(o,request.auth.uid)); }
  function role(o) { return get(member(o,request.auth.uid)).data.role; }
  function collector(o) { return signed(o) && role(o) in ['owner','disbursing']; }
  function owner(o) { return signed(o) && role(o) == 'owner'; }
  function president(o) { return signed(o) && exists(config(o)) && get(config(o)).data.presidentUid == request.auth.uid; }
  function only(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
  function short(s, n) { return s is string && s.size() > 0 && s.size() <= n; }
  function validAmount(n) { return n is int && n > 0 && n <= 100000000; }
  match /organizations/{o}/sparkConfig/{id} {
   allow read: if signed(o) && id == 'current';
   allow create, update: if id == 'current' && owner(o)
     && request.resource.data.keys().hasOnly(['presidentUid','assignedAt','assignedBy'])
     && short(request.resource.data.presidentUid,128)
     && exists(member(o,request.resource.data.presidentUid))
     && request.resource.data.assignedAt == request.time && request.resource.data.assignedBy == request.auth.uid;
   allow delete: if false;
  }
  match /organizations/{o}/sparkPeople/{p} {
   allow read: if signed(o);
   allow create: if collector(o) && p.matches('^[A-Za-z0-9_-]{1,80}$')
     && request.resource.data.keys().hasOnly(['name','createdAt','createdBy'])
     && short(request.resource.data.name,160) && request.resource.data.name.matches('.*[^ ].*')
     && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
   allow update, delete: if false;
  }
  match /organizations/{o}/sparkPayments/{p} {
   allow read: if signed(o);
   allow create: if collector(o) && request.resource.data.keys().hasOnly(['personId','memberName','absenceDate','paymentDate','amountCents','createdAt','createdBy','remittanceId'])
     && short(request.resource.data.personId,80) && request.resource.data.personId.matches('^[A-Za-z0-9_-]+$')
     && exists(person(o,request.resource.data.personId)) && request.resource.data.memberName == get(person(o,request.resource.data.personId)).data.name
     && request.resource.data.absenceDate is string && request.resource.data.absenceDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
     && p == request.resource.data.personId + '~' + request.resource.data.absenceDate
     && request.resource.data.paymentDate is string && request.resource.data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
     && validAmount(request.resource.data.amountCents) && request.resource.data.createdAt == request.time
     && request.resource.data.createdBy == request.auth.uid && request.resource.data.remittanceId == null;
   allow update: if (collector(o) && only(['remittanceId']) && resource.data.remittanceId == null
     && short(request.resource.data.remittanceId,128)
     && get(remit(o,request.resource.data.remittanceId)).data.status == 'draft'
     && getAfter(remit(o,request.resource.data.remittanceId)).data.status == 'draft'
     && getAfter(remit(o,request.resource.data.remittanceId)).data.lastPaymentId == p
     && getAfter(remit(o,request.resource.data.remittanceId)).data.count == get(remit(o,request.resource.data.remittanceId)).data.count + 1
     && getAfter(remit(o,request.resource.data.remittanceId)).data.amountCents == get(remit(o,request.resource.data.remittanceId)).data.amountCents + resource.data.amountCents
     && !exists(line(o,request.resource.data.remittanceId,p))
     && getAfter(line(o,request.resource.data.remittanceId,p)).data.paymentId == p)
     || (collector(o) && only(['remittanceId']) && resource.data.remittanceId is string && request.resource.data.remittanceId == null
       && get(remit(o,resource.data.remittanceId)).data.status in ['declined','cancelled','voided']);
   allow delete: if false;
  }
  match /organizations/{o}/sparkRemittances/{r} {
   allow read: if signed(o);
   allow create: if collector(o) && r.matches('^[A-Za-z0-9_-]{1,128}$') && request.resource.data.keys().hasOnly(['status','amountCents','count','lastPaymentId','createdBy','createdAt','correctionId'])
     && request.resource.data.status == 'draft' && request.resource.data.amountCents == 0 && request.resource.data.count == 0
     && request.resource.data.lastPaymentId == null && request.resource.data.correctionId == null && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
   allow update: if (
     collector(o) && resource.data.status == 'draft' && request.resource.data.status == 'draft'
     && only(['count','amountCents','lastPaymentId']) && resource.data.count < 200
     && short(request.resource.data.lastPaymentId,128)
     && get(payment(o,request.resource.data.lastPaymentId)).data.remittanceId == null
     && getAfter(payment(o,request.resource.data.lastPaymentId)).data.remittanceId == r
     && !exists(line(o,r,request.resource.data.lastPaymentId))
     && getAfter(line(o,r,request.resource.data.lastPaymentId)).data.paymentId == request.resource.data.lastPaymentId
     && request.resource.data.count == resource.data.count + 1
     && request.resource.data.amountCents == resource.data.amountCents + get(payment(o,request.resource.data.lastPaymentId)).data.amountCents
    ) || (
     collector(o) && resource.data.status == 'draft' && resource.data.count > 0
     && only(['status','presidentUid','submittedAt']) && request.resource.data.status == 'pending'
     && request.resource.data.presidentUid == get(config(o)).data.presidentUid
     && exists(member(o,request.resource.data.presidentUid)) && request.resource.data.submittedAt == request.time
    ) || (
     president(o) && resource.data.status == 'pending' && resource.data.presidentUid == request.auth.uid
     && only(['status','acceptedBy','acceptedAt']) && request.resource.data.status == 'accepted'
     && request.resource.data.acceptedBy == request.auth.uid && request.resource.data.acceptedAt == request.time
     && getAfter(ledger(o)).data.lastKind == 'accept' && getAfter(ledger(o)).data.lastId == r
     && getAfter(ledger(o)).data.revision == get(ledger(o)).data.revision + 1
    ) || (
     president(o) && resource.data.status == 'pending' && resource.data.presidentUid == request.auth.uid
     && only(['status','declinedBy','declinedAt','reason']) && request.resource.data.status == 'declined'
     && request.resource.data.declinedBy == request.auth.uid && request.resource.data.declinedAt == request.time && short(request.resource.data.reason,500)
    ) || (
     collector(o) && resource.data.status in ['draft','pending'] && only(['status','cancelledBy','cancelledAt','reason'])
     && request.resource.data.status == 'cancelled' && request.resource.data.cancelledBy == request.auth.uid
     && request.resource.data.cancelledAt == request.time && short(request.resource.data.reason,500)
   ) || (
     collector(o) && resource.data.status == 'accepted' && resource.data.correctionId == null
     && only(['correctionId']) && short(request.resource.data.correctionId,128)
     && !exists(correction(o,request.resource.data.correctionId))
     && getAfter(correction(o,request.resource.data.correctionId)).data.remittanceId == r
     && getAfter(correction(o,request.resource.data.correctionId)).data.status == 'pending'
   ) || (
     president(o) && resource.data.status == 'accepted' && resource.data.correctionId is string
     && request.resource.data.correctionId == null && only(['correctionId'])
     && get(correction(o,resource.data.correctionId)).data.status == 'pending'
     && getAfter(correction(o,resource.data.correctionId)).data.status == 'declined'
     && getAfter(correction(o,resource.data.correctionId)).data.decidedBy == request.auth.uid
   ) || (
     president(o) && resource.data.status == 'accepted' && resource.data.correctionId is string
     && only(['status','voidedAt','voidedBy']) && request.resource.data.status == 'voided'
     && request.resource.data.voidedAt == request.time && request.resource.data.voidedBy == request.auth.uid
     && get(correction(o,resource.data.correctionId)).data.status == 'pending'
     && getAfter(correction(o,resource.data.correctionId)).data.status == 'approved'
     && getAfter(correction(o,resource.data.correctionId)).data.decidedBy == request.auth.uid
     && getAfter(ledger(o)).data.lastKind == 'correction' && getAfter(ledger(o)).data.lastId == r
     && getAfter(ledger(o)).data.revision == get(ledger(o)).data.revision + 1
   );
   allow delete: if false;
  }
  match /organizations/{o}/sparkCorrections/{c} {
   allow read: if signed(o);
   allow create: if collector(o) && request.resource.data.keys().hasOnly(['remittanceId','status','requestedBy','requestedAt','reason'])
     && short(request.resource.data.remittanceId,128) && request.resource.data.status == 'pending'
     && request.resource.data.requestedBy == request.auth.uid && request.resource.data.requestedAt == request.time && short(request.resource.data.reason,500)
     && get(remit(o,request.resource.data.remittanceId)).data.status == 'accepted'
     && get(remit(o,request.resource.data.remittanceId)).data.correctionId == null
     && getAfter(remit(o,request.resource.data.remittanceId)).data.correctionId == c;
   allow update: if president(o) && resource.data.status == 'pending'
     && request.resource.data.decidedBy == request.auth.uid && request.resource.data.decidedAt == request.time
     && get(remit(o,resource.data.remittanceId)).data.correctionId == c
     && ((request.resource.data.status == 'declined' && only(['status','decidedBy','decidedAt','decisionReason'])
       && short(request.resource.data.decisionReason,500) && getAfter(remit(o,resource.data.remittanceId)).data.correctionId == null)
       || (request.resource.data.status == 'approved' && only(['status','decidedBy','decidedAt'])
       && getAfter(remit(o,resource.data.remittanceId)).data.status == 'voided'
       && getAfter(remit(o,resource.data.remittanceId)).data.voidedBy == request.auth.uid));
   allow delete: if false;
  }
  match /organizations/{o}/sparkLines/{lineId} {
   allow read: if signed(o);
   allow create: if collector(o) && request.resource.data.keys().hasOnly(['remittanceId','paymentId','amountCents','linkedAt','linkedBy'])
     && short(request.resource.data.remittanceId,128) && short(request.resource.data.paymentId,128)
     && lineId == request.resource.data.remittanceId + '~' + request.resource.data.paymentId
     && get(remit(o,request.resource.data.remittanceId)).data.status == 'draft'
     && get(payment(o,request.resource.data.paymentId)).data.remittanceId == null
     && getAfter(payment(o,request.resource.data.paymentId)).data.remittanceId == request.resource.data.remittanceId
     && getAfter(remit(o,request.resource.data.remittanceId)).data.lastPaymentId == request.resource.data.paymentId
     && request.resource.data.amountCents == get(payment(o,request.resource.data.paymentId)).data.amountCents
     && request.resource.data.linkedAt == request.time && request.resource.data.linkedBy == request.auth.uid;
   allow update, delete: if false;
  }
  // These are explicit human confirmations, not evidence of physical printing.
  match /organizations/{o}/sparkMemberReceipts/{id} {
   allow read: if signed(o);
   allow create: if collector(o) && request.resource.data.keys().hasOnly(['paymentId','remittanceId','printedBy','printedAt'])
     && short(request.resource.data.paymentId,128) && short(request.resource.data.remittanceId,128)
     && id == request.resource.data.remittanceId + '~' + request.resource.data.paymentId
     && request.resource.data.printedBy == request.auth.uid && request.resource.data.printedAt == request.time
     && get(payment(o,request.resource.data.paymentId)).data.remittanceId == request.resource.data.remittanceId
     && get(remit(o,request.resource.data.remittanceId)).data.status == 'accepted'
     && get(remit(o,request.resource.data.remittanceId)).data.correctionId == null;
   allow update, delete: if false;
  }
  match /organizations/{o}/sparkRemittanceReceipts/{r} {
   allow read: if signed(o);
   allow create: if collector(o) && request.resource.data.keys().hasOnly(['printedBy','printedAt'])
     && request.resource.data.printedBy == request.auth.uid && request.resource.data.printedAt == request.time
     && get(remit(o,r)).data.status == 'accepted' && get(remit(o,r)).data.correctionId == null;
   allow update, delete: if false;
  }
  match /organizations/{o}/sparkLedger/{id} {
   allow read: if signed(o) && id == 'current';
   allow create: if owner(o) && id == 'current' && request.resource.data.keys().hasOnly(['balanceCents','revision','lastKind','lastId','lastAcceptedAt','lastExpenseAt'])
     && request.resource.data.lastAcceptedAt == null && request.resource.data.lastExpenseAt == null
     && request.resource.data.balanceCents == 0 && request.resource.data.revision == 0
     && request.resource.data.lastKind == 'init' && request.resource.data.lastId == '';
   allow update: if id == 'current' && signed(o) && only(['balanceCents','revision','lastKind','lastId','lastAcceptedAt','lastExpenseAt'])
     && request.resource.data.revision == resource.data.revision + 1 && short(request.resource.data.lastId,128)
     && (
      (president(o) && request.resource.data.lastKind == 'accept'
       && request.resource.data.lastAcceptedAt == request.time && request.resource.data.lastExpenseAt == resource.data.lastExpenseAt
       && get(remit(o,request.resource.data.lastId)).data.status == 'pending'
       && get(remit(o,request.resource.data.lastId)).data.presidentUid == request.auth.uid
       && getAfter(remit(o,request.resource.data.lastId)).data.status == 'accepted'
       && getAfter(remit(o,request.resource.data.lastId)).data.acceptedBy == request.auth.uid
       && request.resource.data.balanceCents == resource.data.balanceCents + get(remit(o,request.resource.data.lastId)).data.amountCents)
      ||
      (president(o) && request.resource.data.lastKind == 'correction'
       && resource.data.lastExpenseAt == null && request.resource.data.lastExpenseAt == null
       && request.resource.data.lastAcceptedAt == resource.data.lastAcceptedAt
       && get(remit(o,request.resource.data.lastId)).data.status == 'accepted'
       && getAfter(remit(o,request.resource.data.lastId)).data.status == 'voided'
       && getAfter(remit(o,request.resource.data.lastId)).data.voidedBy == request.auth.uid
       && request.resource.data.balanceCents == resource.data.balanceCents - get(remit(o,request.resource.data.lastId)).data.amountCents
       && request.resource.data.balanceCents >= 0)
      ||
      (collector(o) && request.resource.data.lastKind == 'expense'
       && request.resource.data.lastAcceptedAt == resource.data.lastAcceptedAt
       && request.resource.data.lastExpenseAt == getAfter(expense(o,request.resource.data.lastId)).data.occurredAt
       && !exists(expense(o,request.resource.data.lastId))
       && getAfter(expense(o,request.resource.data.lastId)).data.createdBy == request.auth.uid
       && request.resource.data.balanceCents == resource.data.balanceCents - getAfter(expense(o,request.resource.data.lastId)).data.amountCents
       && request.resource.data.balanceCents >= 0)
     );
   allow delete: if false;
  }
  match /organizations/{o}/sparkExpenses/{e} {
   allow read: if signed(o);
   allow create: if collector(o) && request.resource.data.keys().hasOnly(['amountCents','description','occurredAt','createdAt','createdBy'])
     && request.resource.data.occurredAt is timestamp && request.resource.data.occurredAt <= request.time
     && get(ledger(o)).data.lastAcceptedAt is timestamp && request.resource.data.occurredAt >= get(ledger(o)).data.lastAcceptedAt
     && (get(ledger(o)).data.lastExpenseAt == null || request.resource.data.occurredAt >= get(ledger(o)).data.lastExpenseAt)
     && validAmount(request.resource.data.amountCents) && short(request.resource.data.description,300)
     && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid
     && getAfter(ledger(o)).data.lastKind == 'expense' && getAfter(ledger(o)).data.lastId == e
     && getAfter(ledger(o)).data.revision == get(ledger(o)).data.revision + 1;
   allow update, delete: if false;
  }
 }
}
