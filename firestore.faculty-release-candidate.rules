   allow update: if (collector(o) && resource.data.releasedAt == null && only(['releasedAt','releasedBy'])
     && request.resource.data.releasedAt == request.time && request.resource.data.releasedBy == request.auth.uid
     && get(expenseDraft(o,resource.data.expenseId)).data.status in ['cancelling','voiding']
     && get(wallet(o,resource.data.walletId)).data.status == 'open'
     && getAfter(wallet(o,resource.data.walletId)).data.lastRelease == a
     && getAfter(wallet(o,resource.data.walletId)).data.revision == get(wallet(o,resource.data.walletId)).data.revision + 1
     && getAfter(expenseDraft(o,resource.data.expenseId)).data.lastRelease == a
     && getAfter(expenseDraft(o,resource.data.expenseId)).data.count == get(expenseDraft(o,resource.data.expenseId)).data.count - 1) && revisionAdvanced(o);
   allow delete: if false;
  }
  }
}
